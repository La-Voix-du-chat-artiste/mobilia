header.flex.flex-col.lg:flex-row.items-center.justify-between.mb-6.gap-3
  h1.text-3xl= t('views.places.index.title')

  - if allowed_to?(:create?, Place)
    = link_to t('views.places.index.add'), new_place_path, class: 'btn-add'

- unless current_user.standard?
  details.panel-info.mb-5 open=options.show_help?
    summary.cursor-pointer= t('views.places.index.help_title')
    p.mt-3= t('views.places.index.help_text')

- if @places.any?
  = simple_form_for :search,
                    url: places_path,
                    method: :get,
                    html: { class: 'mb-6' },
                    data: { \
                      turbo_stream: true,
                      controller: 'search', \
                      action: 'keyup->search#submit' \
                    } do |f|
    = f.input :query,
              label: false,
              placeholder: t('views.places.index.search_placeholder'),
              input_html: { class: 'rounded-lg' },
              wrapper_html: { class: 'lg:w-1/2 mx-auto' }

  = turbo_frame_tag :search do
    = render 'places', places: @places, pagy: @pagy

  - if options.enable_places_map?
    div data-controller="global-map" data-global-map-places-url-value=places_path
      #map class="h-[500px]" data-global-map-target="map"

- else
  p.panel-warning.p-4
    = t('views.places.index.empty')

    - if allowed_to?(:create?, Place)
      =< link_to t('common.add_first'), new_place_path, class: 'underline'
