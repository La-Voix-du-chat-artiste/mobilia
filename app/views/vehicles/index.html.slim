header.flex.flex-col.lg:flex-row.items-center.justify-between.mb-6.gap-3
  h1.text-3xl= t('views.vehicles.index.title')

  - if allowed_to?(:create?, Vehicle)
    = link_to t('views.vehicles.index.add'), new_vehicle_path, class: 'btn-add'

- unless current_user.standard?
  details.panel-info.mb-5 open=options.show_help?
    summary.cursor-pointer= t('views.vehicles.index.help_title')

    p.mt-3= t('views.vehicles.index.help_text')

- if @vehicles.any?
  == pagy_nav(@pagy) if @pagy.pages > 1

  #vehicles
    = render @vehicles

  == pagy_nav(@pagy) if @pagy.pages > 1

- else
  p.panel-warning.p-4
    = t('views.vehicles.index.empty')

    - if allowed_to?(:create?, Vehicle)
      =< link_to t('common.add_first'), new_vehicle_path, class: 'underline'
