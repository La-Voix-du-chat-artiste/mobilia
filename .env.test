# Committed on purpose (.gitignore un-ignores .env.test).
#
# These are deliberately NOT secrets. They only ever protect the throwaway test
# database, which CI rebuilds from db/schema.rb on every run, which is why this
# file replaces what would otherwise look like leaked key material. Committing
# real keys here would be a credential leak; these names say what they are, and
# they are the only reason `RAILS_ENV=test` can boot with no local .env.
#
# No port here: config/database.yml defaults the test database to 5432 (what CI's
# Postgres service uses) and .env overrides POSTGRES_TEST_PORT locally.
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=mobilia
POSTGRES_PASSWORD=mobilia
POSTGRES_TEST_DB=mobilia_test

SECRET_KEY_BASE=test_only_secret_key_base_not_a_secret
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=test_only_primary_key_not_a_secret
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=test_only_deterministic_key_not_a_secret
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=test_only_key_derivation_salt_not_a_secret
