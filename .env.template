# Copy this file to .env and fill it in, or just run `bin/setup`, which writes a
# .env with freshly generated secrets. None of the values here are usable as-is.
#
# The one section you cannot skip is the Active Record encryption keys: the
# application refuses to boot without them.

PORT=3000

# Optional in development (Rails falls back to tmp/local_secret.txt).
# Generate with `bin/rails secret`.
# SECRET_KEY_BASE=

# Database. These match docker-compose.yml.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5432
POSTGRES_USER=mobilia
POSTGRES_PASSWORD=mobilia
POSTGRES_DB=mobilia_development
POSTGRES_TEST_DB=mobilia_test

# Redis (Action Cable, Geocoder cache)
REDIS_URL=redis://127.0.0.1:6379/1

# HTTP basic auth in front of the mounted GoodJob dashboard. The dashboard is
# not mounted in production without these.
GOODJOB_USERNAME=admin
GOODJOB_PASSWORD=

# Generate with `bin/rails db:encryption:init`.
# These keys protect users' names, phones and emails. Never regenerate them for
# a database that already holds encrypted rows: the data becomes unreadable.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Host used in outgoing email links (production only).
MAILER_HOST=mobilia.flownaely.cafe
