#!/usr/bin/env ruby
require 'fileutils'
require 'securerandom'

# path to your application root.
APP_ROOT = File.expand_path('..', __dir__)

def system!(*)
  system(*, exception: true)
end

FileUtils.chdir APP_ROOT do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  puts '== Installing dependencies =='
  system! 'gem install bundler --conservative'
  system('bundle check') || system!('bundle install')

  puts "\n== Preparing environment =="
  if File.exist?('.env')
    puts '.env already exists, leaving it alone.'
  else
    # The application refuses to boot without the Active Record encryption keys,
    # and `bin/rails db:encryption:init` only prints them, so bin/setup has to
    # write .env itself. Same shape as .env.template.
    File.write('.env', <<~ENVFILE)
      # Generated by bin/setup. Not committed (see .gitignore).
      PORT=3000
      SECRET_KEY_BASE=#{SecureRandom.hex(64)}

      # Database
      POSTGRES_HOST=127.0.0.1
      POSTGRES_PORT=5432
      POSTGRES_TEST_PORT=5432
      POSTGRES_USER=mobilia
      POSTGRES_PASSWORD=mobilia
      POSTGRES_DB=mobilia_development
      POSTGRES_TEST_DB=mobilia_test

      # Redis (Action Cable, Geocoder cache)
      REDIS_URL=redis://127.0.0.1:6379/1

      # HTTP basic auth in front of the mounted GoodJob dashboard
      GOODJOB_USERNAME=admin
      GOODJOB_PASSWORD=#{SecureRandom.alphanumeric(16)}

      # Active Record encryption. These keys protect users' names, phones and
      # emails: keep them, and never regenerate them for a database that already
      # holds encrypted rows.
      ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=#{SecureRandom.alphanumeric(32)}
      ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=#{SecureRandom.alphanumeric(32)}
      ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=#{SecureRandom.alphanumeric(32)}
    ENVFILE
    puts 'Wrote .env with freshly generated secrets.'
  end

  puts "\n== Preparing database =="
  puts '(PostgreSQL must be running, and the role/database from .env must exist: `docker compose up -d`)'
  system! 'bin/rails db:prepare'

  puts "\n== Removing old logs and tempfiles =="
  system! 'bin/rails log:clear tmp:clear'

  puts "\n== Restarting application server =="
  system! 'bin/rails restart'
end
